{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "standard",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "eqeqeq": "error",
    "curly": "error",
    "semi": "error",
    "camelcase": "off"
  },
  "ignorePatterns": ["node_modules/", ".env"]
}
